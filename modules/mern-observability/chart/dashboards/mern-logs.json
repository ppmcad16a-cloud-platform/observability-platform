{
  "uid": "mern-logs",
  "title": "MERN shop - logs",
  "description": "Logs of the shop's pods, collected by Alloy into each cluster's Loki.",
  "tags": [
    "mern",
    "logs"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "logs",
        "label": "Cloud",
        "type": "datasource",
        "query": "loki",
        "regex": "/^Loki /",
        "multi": false,
        "includeAll": false
      },
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "query": "api-gateway-service,identity-service,catalog-service,commerce-service,notification-service,client-service",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "search",
        "label": "Text contains",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Log lines mentioning 'error' (per service, 5 min)",
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "legendFormat": "{{app}}",
          "expr": "sum by (app) (count_over_time({namespace=\"mern\", app=~\"$service\"} |~ \"(?i)error\" [5m]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Logs",
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "gridPos": {
        "h": 18,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "expr": "{namespace=\"mern\", app=~\"$service\"} |~ \"(?i)$search\""
        }
      ]
    }
  ]
}
